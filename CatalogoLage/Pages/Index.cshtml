@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div id="grid">
    <a asp-page="/Catalog/Index" class="tile left" style="--bg: url('/img/bg-vino.jpg');" aria-label="Catálogo de Vino">
        <span class="label">Vino</span>
    </a>
    <a asp-page="/Destilados/Index" class="tile center" style="--bg: url('/img/bg-destilados.jpg');" aria-label="Catálogo de Destilados">
        <span class="label">Destilados</span>
    </a>
    <a asp-page="/Cafe/Index" class="tile right" style="--bg: url('/img/bg-cafe.jpg');" aria-label="Catálogo de Café e Infusiones">
        <span class="label">Café e Infusiones</span>
    </a>
</div>

<style>
  body { margin: 0; }

  #grid {
    width: 100vw;
    height: 100vh;
    transition: 500ms;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0; /* sin huecos: ocupan todo el ancho */
    background: #000; /* no visible al no haber huecos */
  }

  /* Tiles base */
  .tile { 
    position: relative;
    display: flex; 
    align-items: center; 
    justify-content: center; 
    text-decoration: none; 
    color: #fff;
    font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    text-transform: uppercase;
    letter-spacing: .05em;
    font-weight: 700;
    background-color: #000; /* solo fallback, no sobrescribe la imagen */
    background-image: var(--bg);
    background-size: cover; 
    background-position: center; 
    transition: 300ms;
    overflow: hidden;
  }

  /* Sin overlay ni colores en hover: siempre se ve la imagen */
  .tile::after { display: none; }

  .label { 
    position: relative; 
    z-index: 1; 
    font-size: clamp(1.2rem, 3vw, 2rem); 
    text-align: center; 
    padding: .75rem 1.25rem; 
    /* quitar recuadro de fondo */
    background: transparent; 
  }

  /* Column expansion animation using :has() */
  #grid:has(.left:hover) { grid-template-columns: 2fr .5fr .5fr; }
  #grid:has(.center:hover) { grid-template-columns: .5fr 2fr .5fr; }
  #grid:has(.right:hover) { grid-template-columns: .5fr .5fr 2fr; }

  @@media (prefers-reduced-motion: reduce) {
    #grid { transition: none; }
    .tile { transition: none; }
  }
</style>

@page
@model CatalogoLage.Pages.Admin.Otros.IndexModel
@{
    ViewData["Title"] = "Otros";
}
<h1>Herramientas varias</h1>

@if (!User.IsInRole("Admin"))
{
    <div class="alert alert-danger">Acceso restringido.</div>
}
else
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Migrar imágenes a Base64</h5>
            <p class="card-text">1) Descarga el JSON de copia de seguridad con todos los enlaces actuales. 2) Confirma que lo has guardado y su contenido es válido. 3) Ejecuta la migración.</p>

            <form method="post" asp-page-handler="ExportLinks" class="d-inline">
                <button disabled type="submit" class="btn btn-outline-secondary">Descargar JSON de enlaces</button>
            </form>

            <form method="post" asp-page-handler="ConfirmBackup" class="d-inline ms-2">
                <button disabled type="submit" class="btn btn-success">He guardado el JSON. Continuar</button>
            </form>

            @if (Model.CanRunMigration)
            {
                <form method="post" asp-page-handler="RunMigration" class="mt-3">
                    <input type="hidden" name="BackupReady" value="true" />
                    <input type="hidden" name="CanRunMigration" value="true" />
                    <button disabled type="submit" class="btn btn-primary">Ejecutar migración</button>
                </form>
            }
            else
            {
                <div class="alert alert-info mt-3">
                    La migración permanecerá bloqueada hasta que confirmes que has guardado y validado el JSON.
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.StatusMessage))
            {
                <div class="alert alert-warning mt-3">@Model.StatusMessage</div>
            }
        </div>
    </div>
}

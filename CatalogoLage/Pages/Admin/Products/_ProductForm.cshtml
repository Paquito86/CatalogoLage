@model CatalogoLage.Models.Product
@inject CatalogoLage.Data.ApplicationDbContext Ctx
@{
    var categories = Ctx.Categories.OrderBy(c=>c.Name).ToList();
    var grapeTypes = Ctx.GrapeTypes.OrderBy(g=>g.Name).ToList();
    // Categorías de vino
    var wineCategoryNames = new List<string> { "Vinos Dulces", "Vino Rosado", "Vino Espumoso", "Vino Tinto", "Vino Blanco" };
}
<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<!--<div class="mb-3">
    <label asp-for="Manufacturer" class="form-label">Fabricante</label>
    <input asp-for="Manufacturer" class="form-control" />
    <span class="form-text">Para vinos, dejar vacío y completar Bodega</span>
</div>-->
<div class="mb-3">
    <label asp-for="CategoryId" class="form-label">Categoría</label>
    <select asp-for="CategoryId" class="form-select" id="categorySelect" asp-items="@(new SelectList(categories, nameof(CatalogoLage.Models.Category.Id), nameof(CatalogoLage.Models.Category.Name)))"></select>
</div>
<div class="mb-3" id="wineryField">
    <label asp-for="Winery" class="form-label">Bodega</label>
    <input asp-for="Winery" class="form-control" />
</div>
<div class="mb-3" id="manufacturerField" style="display: none;">
    <label asp-for="Manufacturer" class="form-label">Fabricante</label>
    <input asp-for="Manufacturer" class="form-control" />
    <span class="form-text">Para productos no vinos</span>
</div>
<div class="mb-3">
    <label asp-for="GrapeTypeId" class="form-label">Tipo de uva (opcional)</label>
    <select asp-for="GrapeTypeId" class="form-select" asp-items="@(new SelectList(grapeTypes, nameof(CatalogoLage.Models.GrapeType.Id), nameof(CatalogoLage.Models.GrapeType.Name)))">
        <option value="">-- Sin especificar --</option>
    </select>
</div>
<div class="mb-3">
    <label class="form-label">Precio (opcional)</label>
    <input asp-for="Price" class="form-control" type="text" inputmode="decimal" placeholder="Ej. 12,50" />
    <div class="form-text">Usa coma (,) como separador decimal. Deja vacío si no aplica.</div>
    <span asp-validation-for="Price" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Size" class="form-label"></label>
    <input asp-for="Size" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="AlcoholPercent" class="form-label">% Alcohol (opcional)</label>
    <input asp-for="AlcoholPercent"
           class="form-control"
           type="text"
           inputmode="decimal"
           placeholder="Ej. 13,50"
           pattern="^\d{1,3}([,\.]\d{1,2})?$"
           data-val="true"
           data-val-regex="Formato no válido. Usa coma (,) como separador decimal."
           data-val-regex-pattern="^\d{1,3}([,\.]\d{1,2})?$" />
    <div class="form-text">Usa coma (,) como separador decimal. Deja vacío si no aplica.</div>
    <span asp-validation-for="AlcoholPercent" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Origin" class="form-label">Origen</label>
    <input asp-for="Origin" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="ImageUrl" class="form-label">URL Imagen</label>
    <input asp-for="ImageUrl" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" rows="4" class="form-control"></textarea>
</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const categorySelect = document.getElementById('categorySelect');
    const wineryField = document.getElementById('wineryField');
    const manufacturerField = document.getElementById('manufacturerField');
    const wineCategoryNames = @Html.Raw(Json.Serialize(wineCategoryNames));

    function updateFields() {
        const selectedOption = categorySelect.options[categorySelect.selectedIndex];
        const categoryName = selectedOption ? selectedOption.text : '';
        const isWine = wineCategoryNames.includes(categoryName);
        if (isWine) {
            wineryField.style.display = 'block';
            manufacturerField.style.display = 'none';
        } else {
            wineryField.style.display = 'none';
            manufacturerField.style.display = 'block';
        }
    }

    categorySelect.addEventListener('change', updateFields);
    updateFields(); // Inicial
});
</script>
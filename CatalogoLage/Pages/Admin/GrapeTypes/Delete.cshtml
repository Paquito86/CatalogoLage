@page "{id:int}"
@model CatalogoLage.Pages.Admin.GrapeTypes.DeleteModel
@{
    ViewData["Title"] = "Eliminar tipo de uva";
}
<h1>Eliminar tipo de uva</h1>
@if(Model.Item != null){
<div class="alert alert-warning">
    ¿Seguro que desea eliminar <strong>@Model.Item.Name</strong>? Esta acción eliminará también los productos asociados.
</div>
<form method="post">
    <button class="btn btn-danger" type="submit">Sí, eliminar</button>
    <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
</form>
}
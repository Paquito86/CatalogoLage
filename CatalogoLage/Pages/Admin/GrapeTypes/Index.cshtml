@page
@model CatalogoLage.Pages.Admin.GrapeTypes.IndexModel
@{
    ViewData["Title"] = "Tipos de uva";
}
<h1>Tipos de uva</h1>
<p><a asp-page="Create" class="btn btn-primary">Nuevo tipo</a> <a asp-page="../Products/Index" class="btn btn-secondary">Volver a Productos</a></p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th># Productos</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var g in Model.Items)
{
    <tr>
        <td>@g.Name</td>
        <td>@g.Description</td>
        <td>@Model.ProductCounts.GetValueOrDefault(g.Id)</td>
        <td>
            <a asp-page="Edit" asp-route-id="@g.Id">Editar</a> |
            <a asp-page="Delete" asp-route-id="@g.Id">Eliminar</a>
        </td>
    </tr>
}
    </tbody>
</table>
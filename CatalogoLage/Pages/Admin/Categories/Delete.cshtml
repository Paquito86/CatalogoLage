@page "{id:int}"
@model CatalogoLage.Pages.Admin.Categories.DeleteModel
@{
    ViewData["Title"] = "Eliminar Categoría";
}
<h1>Eliminar Categoría</h1>
@if(Model.Category != null){
<div class="alert alert-warning">
    ¿Seguro que desea eliminar <strong>@Model.Category.Name</strong>? Esta acción eliminará también los productos asociados.
</div>
<form method="post">
    <button class="btn btn-danger" type="submit">Sí, eliminar</button>
    <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
</form>
}
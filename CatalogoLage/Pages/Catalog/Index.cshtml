@page
@model CatalogoLage.Pages.Catalog.IndexModel
@{
    ViewData["Title"] = "Catálogo";
}
<h1>Catálogo de Productos</h1>

@if (User.IsInRole("Admin"))
{
    <div class="mb-3">
        <form method="get" class="d-inline">
            @* Preservar parámetros de búsqueda *@
            @if (!string.IsNullOrEmpty(Model.Query)) { <input type="hidden" name="Query" value="@Model.Query" /> }
            @if (Model.CategoryId.HasValue) { <input type="hidden" name="CategoryId" value="@Model.CategoryId" /> }
            @if (!string.IsNullOrEmpty(Model.Winery)) { <input type="hidden" name="Winery" value="@Model.Winery" /> }
            @if (!string.IsNullOrEmpty(Model.Origin)) { <input type="hidden" name="Origin" value="@Model.Origin" /> }
            @if (Model.GrapeTypeId.HasValue) { <input type="hidden" name="GrapeTypeId" value="@Model.GrapeTypeId" /> }
            
            @if (Model.AdminMode)
            {
                <input type="hidden" name="AdminMode" value="false" />
                <button type="submit" class="btn btn-secondary">Salir del modo edición</button>
            }
            else
            {
                <input type="hidden" name="AdminMode" value="true" />
                <button type="submit" class="btn btn-warning">Modo edición de matriz</button>
            }
        </form>
    </div>
}

@* Token antifalsificación *@
@if (Model.IsAdminMode)
{
    <form style="display: none;">
        @Html.AntiForgeryToken()
    </form>
}

<form method="get" class="mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label for="q" class="form-label">Buscar</label>
            <input id="q" name="Query" value="@Model.Query" class="form-control" placeholder="Nombre, descripción, fabricante o bodega" />
        </div>
        <div class="col-md-3">
            <label for="categoryId" class="form-label">Categoría</label>
            <select id="categoryId" name="categoryId" class="form-select">
                <option value="">-- Todas --</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-grid">
            <button class="btn btn-primary" type="submit">Filtrar</button>
        </div>
    </div>
    <div class="row g-2 mt-2">
        <div class="col-md-4">
            <label for="Winery" class="form-label">Bodega</label>
            <select id="Winery" name="Winery" class="form-select">
                <option value="">-- Todas --</option>
                @foreach (var w in Model.Wineries)
                {
                    <option value="@w" selected="@(Model.Winery == w)">@w</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label for="Origin" class="form-label">Denominación de Origen</label>
            <select id="Origin" name="Origin" class="form-select">
                <option value="">-- Todas --</option>
                @foreach (var o in Model.Origins)
                {
                    <option value="@o" selected="@(Model.Origin == o)">@o</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label for="GrapeTypeId" class="form-label">Tipo de uva</label>
            <select id="GrapeTypeId" name="GrapeTypeId" class="form-select">
                <option value="">-- Todas --</option>
                @foreach (var g in Model.GrapeTypes)
                {
                    <option value="@g.Id" selected="@(Model.GrapeTypeId == g.Id)">@g.Name</option>
                }
            </select>
        </div>
    </div>
    @if (Model.AdminMode) { <input type="hidden" name="AdminMode" value="true" /> }
</form>


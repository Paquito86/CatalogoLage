@{
    var titleRows = Model.TitleRows.ToDictionary(t => t.MatrixY);
}

<div class="matrix-container mb-4">
    <div class="matrix-grid @(Model.IsAdminMode ? "admin-mode" : "view-mode")" style="grid-template-columns: repeat(@Model.MatrixColumns, 1fr);">
        @for (int y = 0; y < Model.MatrixRows; y++)
        {
            if (titleRows.ContainsKey(y))
            {
                var t = titleRows[y];
                <div class="matrix-title-row" style="grid-column: 1 / span @Model.MatrixColumns;">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="m-0">@t.Text @if(Model.IsAdminMode){<small class="text-muted ms-2">Fila @t.MatrixY</small>}</h4>
                        @if (Model.IsAdminMode)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <form method="post" asp-page-handler="UpdateTitle" class="d-flex align-items-end gap-1">
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <input type="hidden" name="AdminMode" value="true" />
                                    <input name="text" class="form-control form-control-sm" value="@t.Text" style="max-width:220px" />
                                    <input name="y" type="number" min="0" class="form-control form-control-sm" value="@t.MatrixY" style="width:90px" />
                                    <button type="submit" class="btn btn-sm btn-outline-success">Guardar</button>
                                </form>
                                <form method="post" asp-page-handler="DeleteTitle" onsubmit="return confirm('¿Eliminar este título?')">
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <input type="hidden" name="AdminMode" value="true" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
                continue;
            }
            for (int x = 0; x < Model.MatrixColumns; x++)
            {
                bool isEmptyReserved = Model.EmptyCells.Contains((x,y));
                <div class="matrix-cell @(Model.IsAdminMode ? "editable" : "") @(isEmptyReserved && Model.IsAdminMode ? "reserved-empty" : "")" data-x="@x" data-y="@y">
                    @if (Model.ProductMatrix[y, x] != null)
                    {
                        var p = Model.ProductMatrix[y, x];
                        <div class="card product-card h-100 @(Model.IsAdminMode ? "draggable" : "")" @(Model.IsAdminMode ? "draggable=\"false\"" : "") data-product-id="@p!.Id" data-x="@x" data-y="@y">
                            @if (Model.IsAdminMode)
                            {
                                <div class="drag-area @(p.MatrixX.HasValue && p.MatrixY.HasValue ? "positioned" : "")" draggable="true">
                                    <div class="drag-handle">
                                        <i class="bi bi-hand-index-thumb fs-5"></i>
                                        <small>Arrastra</small>
                                    </div>
                                </div>
                                <div class="position-indicator">@($"{x},{y}")</div>
                            }
                            <div class="card-horizontal @(Model.IsAdminMode ? "non-draggable" : "")">
                                <div class="product-image-box">
                                    @if (!string.IsNullOrEmpty(p.ImageUrl)) { <img src="@p.ImageUrl" alt="@p.Name" draggable="false" /> }
                                    else if(!Model.IsAdminMode) { <div class="no-image-placeholder"><i class="text-muted">?</i><span class="text-muted small">Sin imagen</span></div> }
                                    else { <div class="no-image-placeholder"><i class="text-muted">?</i></div> }
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title">@p.Name</h5>
                                    <h6 class="card-subtitle mb-2 text-muted">@((p.IsWine ? p.Winery : p.Manufacturer) ?? "")</h6>
                                    @if (!Model.IsAdminMode)
                                    {
                                        if (!string.IsNullOrWhiteSpace(p.Description)) { <p class="card-text">@p.Description</p>; }
                                        <ul class="list-unstyled small product-details">
                                            @if (!string.IsNullOrWhiteSpace(p.Size)) { <li><strong>Tamaño:</strong> @p.Size</li> }
                                            @if (p.AlcoholPercent.HasValue) { <li><strong>% Alcohol:</strong> @p.AlcoholPercent%</li> }
                                            @if (!string.IsNullOrWhiteSpace(p.Origin)) { <li><strong>Origen:</strong> @p.Origin</li> }
                                            @if (p.GrapeType != null) { <li><strong>Tipo de uva:</strong> @p.GrapeType.Name</li> }
                                            <li><strong>Categoría:</strong> @p.Category?.Name</li>
                                        </ul>
                                    }
                                    @if (p.Price.HasValue) { <div class="product-price text-primary fw-bold @(Model.IsAdminMode ? "" : "fs-5")">@p.Price.Value.ToString("C")</div> }
                                </div>
                            </div>
                        </div>
                    }
                    else if (Model.IsAdminMode)
                    {
                        if (isEmptyReserved) { <div class="empty-cell-indicator reserved">@($"{x},{y}")</div> }
                        else { <div class="empty-cell-indicator">@($"{x},{y}")</div> }
                    }
                </div>
            }
        }
    </div>
</div>

@if (Model.IsAdminMode && Model.UnpositionedProducts.Any())
{
    <h5>Productos sin posición asignada (@Model.UnpositionedProducts.Count):</h5>
    <div class="unpositioned-products mb-4">
        @foreach (var p in Model.UnpositionedProducts)
        {
            <div class="card product-card me-2 mb-2" data-product-id="@p.Id" style="width: 330px; display: inline-block;">
                <div class="drag-area @(p.MatrixX.HasValue && p.MatrixY.HasValue ? "positioned" : "")" draggable="true">
                    <div class="drag-handle"><i class="bi bi-hand-index-thumb fs-5"></i><small>Arrastra</small></div>
                </div>
                <div class="card-horizontal non-draggable">
                    <div class="product-image-box small">
                        @if (!string.IsNullOrEmpty(p.ImageUrl)) { <img src="@p.ImageUrl" alt="@p.Name" draggable="false" /> }
                        else { <div class="no-image-placeholder"><i class="text-muted">?</i></div> }
                    </div>
                    <div class="card-body">
                        <h6 class="card-title">@p.Name</h6>
                        <small class="card-subtitle mb-2 text-muted">@((p.IsWine ? p.Winery : p.Manufacturer) ?? "")</small>
                        @if (p.Price.HasValue) { <div class="product-price text-primary fw-bold">@p.Price.Value.ToString("C")</div> }
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (Model.IsAdminMode){<div id="context-menu" class="context-menu d-none"><button type="button" id="btnVaciarCelda" class="dropdown-item">Reservar celda como vacía</button></div>}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        .matrix-container{max-width:1200px;margin:0 auto}.matrix-grid{display:grid;gap:15px;padding:20px;background:#f8f9fa;border-radius:8px}.matrix-grid.view-mode{background:#fff;border:1px solid #dee2e6}.matrix-cell{min-height:250px;border-radius:8px;position:relative;transition:all .3s ease;display:flex;flex-direction:column}.matrix-cell.editable{border:2px dashed #dee2e6}.matrix-cell.editable.drag-over{border-color:#0d6efd;background-color:rgba(13,110,253,.1)}.matrix-cell.reserved-empty{background:repeating-linear-gradient(45deg,#ffe5e5,#ffe5e5 8px,#ffd6d6 8px,#ffd6d6 16px);position:relative}.matrix-cell.reserved-empty::after{content:"VACÍA";position:absolute;top:4px;right:6px;font-size:10px;background:#dc3545;color:#fff;padding:2px 4px;border-radius:3px;font-weight:600;letter-spacing:1px}.matrix-title-row{background:#fff;border:1px solid #ced4da;padding:8px 12px;border-radius:6px}.empty-cell-indicator{position:absolute;top:5px;left:5px;background:rgba(108,117,125,.1);color:#6c757d;padding:2px 5px;border-radius:3px;font-size:10px;font-family:monospace}.empty-cell-indicator.reserved{background:rgba(220,53,69,.15);color:#dc3545;font-weight:600}.position-indicator{position:absolute;top:5px;left:5px;background:rgba(40,167,69,.8);color:#fff;padding:2px 5px;border-radius:3px;font-size:10px;font-family:monospace;z-index:5}.drag-area{position:absolute;top:0;right:0;width:60px;height:60px;background:linear-gradient(135deg,rgba(0,0,0,.8) 0%,rgba(0,0,0,.6) 100%);border-radius:0 .375rem 0 15px;display:flex;align-items:center;justify-content:center;cursor:grab;z-index:20;transition:all .3s ease}.drag-area.positioned{background:linear-gradient(135deg,rgba(40,167,69,.8) 0%,rgba(40,167,69,.6) 100%)}.drag-area.dragging{opacity:.8;transform:rotate(5deg) scale(1.1)}.drag-handle{display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;text-align:center;padding:8px}.drag-handle i{font-size:18px;margin-bottom:2px}.drag-handle small{font-size:8px;line-height:1;opacity:.9;font-weight:400}.non-draggable{user-select:none;pointer-events:none}.unpositioned-products{background:#fff3cd;padding:15px;border-radius:8px;border:1px solid #ffeaa7}.card-horizontal{display:flex;height:100%;overflow:hidden}.product-image-box{width:170px;min-width:170px;height:300px;background:#f8f9fa;display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:.375rem 0 0 .375rem;padding:10px}.admin-mode .product-image-box{width:130px;min-width:130px;height:180px;padding:8px}.product-image-box.small{width:110px;min-width:110px;height:150px;padding:6px}.product-image-box img{max-width:100%;max-height:100%;object-fit:contain;margin:0 auto}.no-image-placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;width:100%;color:#6c757d;font-size:.8rem;text-align:center;padding:15px}.card-body{flex:1;padding:1rem;display:flex;flex-direction:column;justify-content:space-between}.admin-mode .card-body{padding:.75rem}.card-title{font-size:1rem;margin-bottom:.5rem;line-height:1.2}.admin-mode .card-title{font-size:.9rem}.card-subtitle{font-size:.875rem;margin-bottom:.5rem}.product-price{margin-top:auto;text-align:right}.context-menu{position:fixed;z-index:1000;background:#fff;border:1px solid #ced4da;border-radius:.25rem;box-shadow:0 4px 12px rgba(0,0,0,.15);padding:4px 0;width:200px}.context-menu .dropdown-item{width:100%;text-align:left;padding:6px 12px;background:none;border:none;font-size:14px}.context-menu .dropdown-item:hover{background:#0d6efd;color:#fff;cursor:pointer}
    </style>
}

@section Scripts {
    <script>
 document.addEventListener('DOMContentLoaded', function(){
  if(!@Model.IsAdminMode.ToString().ToLower()) return;
  const matrixRows=@Model.MatrixRows; const matrixColumns=@Model.MatrixColumns;
  const reservedRows=new Set([@string.Join(",", Model.TitleRows.Select(t=>t.MatrixY))]);
  const emptyReserved=new Set(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EmptyCells.Select(ec=> ec.x+':'+ec.y))));
  const dragAreas=document.querySelectorAll('.drag-area');
  const allCells=[...document.querySelectorAll('.matrix-cell.editable')].filter(c=>!reservedRows.has(parseInt(c.dataset.y)));
  const contextMenu=document.getElementById('context-menu'); let contextTargetCard=null;
  let autoScrollInterval=null; const scrollEdgeSize=60; const scrollSpeed=12;

  dragAreas.forEach(dragArea=>{ const productCard=dragArea.closest('.card'); const productId=productCard.dataset.productId;
    dragArea.addEventListener('dragstart',function(e){ e.stopPropagation(); this.classList.add('dragging'); productCard.classList.add('being-dragged'); e.dataTransfer.setData('text/plain', productId); e.dataTransfer.effectAllowed='move'; });
    dragArea.addEventListener('dragend',function(){ this.classList.remove('dragging'); productCard.classList.remove('being-dragged'); allCells.forEach(c=>c.classList.remove('drag-over')); stopAutoScroll(); });
    dragArea.addEventListener('mousedown',e=>e.stopPropagation());
  });

  allCells.forEach(cell=>{
    cell.addEventListener('dragover',function(e){ e.preventDefault(); e.dataTransfer.dropEffect='move'; this.classList.add('drag-over'); handleAutoScroll(e.clientY); });
    cell.addEventListener('dragleave',function(e){ if(!this.contains(e.relatedTarget)) this.classList.remove('drag-over'); });
    cell.addEventListener('drop',function(e){ e.preventDefault(); this.classList.remove('drag-over'); stopAutoScroll(); const productId=e.dataTransfer.getData('text/plain'); const x=parseInt(this.dataset.x); const y=parseInt(this.dataset.y); if(x>=0&&x<matrixColumns&&y>=0&&y<matrixRows&&!reservedRows.has(y)){ updateProductPosition(productId,x,y); } });
  });

  function handleAutoScroll(mouseY){ const vh=window.innerHeight; if(vh - mouseY < scrollEdgeSize){ if(!autoScrollInterval){ autoScrollInterval=setInterval(()=>{ window.scrollBy({ top: scrollSpeed, behavior: 'auto'}); }, 16);} } else if(mouseY < scrollEdgeSize){ if(!autoScrollInterval){ autoScrollInterval=setInterval(()=>{ window.scrollBy({ top: -scrollSpeed, behavior: 'auto'}); }, 16);} } else { stopAutoScroll(); } }
  function stopAutoScroll(){ if(autoScrollInterval){ clearInterval(autoScrollInterval); autoScrollInterval=null; } }

  document.addEventListener('selectstart',function(e){ if(e.target.closest('.non-draggable')){ e.preventDefault(); return false; }});

  document.addEventListener('contextmenu',function(e){ const card=e.target.closest('.product-card'); if(card&&card.dataset.productId){ e.preventDefault(); contextTargetCard=card; contextMenu.style.top=e.clientY+'px'; contextMenu.style.left=e.clientX+'px'; contextMenu.classList.remove('d-none'); }});
  document.addEventListener('click',function(){ if(contextMenu) contextMenu.classList.add('d-none'); });

  const btnVaciar=document.getElementById('btnVaciarCelda'); if(btnVaciar){ btnVaciar.addEventListener('click', async function(){ if(!contextTargetCard) return; const productId=contextTargetCard.dataset.productId; const x=contextTargetCard.dataset.x || contextTargetCard.parentElement.dataset.x; const y=contextTargetCard.dataset.y || contextTargetCard.parentElement.dataset.y; if(!confirm('¿Reservar esta celda como vacía?')) return; await vaciarCelda(productId,x,y); }); }

  async function updateProductPosition(productId,x,y){ try{ const token=document.querySelector('input[name="__RequestVerificationToken"]').value; const fd=new FormData(); fd.append('productId',productId); fd.append('x',x); fd.append('y',y); fd.append('__RequestVerificationToken',token); const resp=await fetch('/Catalog?handler=UpdatePosition',{method:'POST',body:fd}); if(resp.ok){ location.reload(); } else { alert('Error: '+await resp.text()); } }catch(err){ console.error(err); alert('Error al actualizar posición'); }}
  async function vaciarCelda(productId,x,y){ try{ const token=document.querySelector('input[name=\"__RequestVerificationToken\"\]').value; const fd=new FormData(); fd.append('productId',productId); fd.append('x',x); fd.append('y',y); fd.append('__RequestVerificationToken',token); const resp=await fetch('/Catalog?handler=VaciarCelda',{method:'POST',body:fd}); if(resp.ok){ location.reload(); } else { alert('Error: '+await resp.text()); } }catch(err){ console.error(err); alert('Error al reservar celda'); }}
 });
    </script>
}
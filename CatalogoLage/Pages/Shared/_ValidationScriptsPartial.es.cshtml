<environment include="Development">
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/localization/messages_es.min.js"></script>
</environment>
<environment exclude="Development">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"
            integrity="sha512-rstIgDs0xPgmG6RX1Aba4KV5cA10uEswFz5TaqvA52lXNSR8j2CGVZC4cy8iV1c9Q6X2sVkm7W+V8b8T5l3Nwg=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"
            integrity="sha512-JyLxSx3RBC2YqDQkTSY66P4kS7w8m5zQ9k3EYf4M1QZCF4a0WCQf3oP4T9V6iA9G3o3S8gJmH4q9xwYN1kX4Ww=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/localization/messages_es.min.js"></script>
</environment>
<script>
// Forzar a aceptar coma como separador decimal en inputs con data-val-number
(function(){
  jQuery.validator.methods.number = function (value, element) {
    if (this.optional(element)) return true;
    return /^-?[0-9]+([\.,][0-9]+)?$/.test(value);
  };
})();
</script>

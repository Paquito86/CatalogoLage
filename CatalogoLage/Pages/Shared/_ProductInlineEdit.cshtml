@using Microsoft.AspNetCore.Antiforgery
@inject IAntiforgery Antiforgery

<!-- Menú contextual reutilizable (solo vista, no modo edición) -->
<div id="global-product-context" class="context-menu d-none">
 <button type="button" id="gpc-edit" class="dropdown-item">Editar producto…</button>
</div>

<!-- Token antifalsificación global -->
<form id="global-antiforgery" style="display:none;">
 @Html.AntiForgeryToken()
</form>

<!-- Modal edición de producto (reutilizable) -->
<div class="modal fade" id="productEditModal" tabindex="-1" aria-labelledby="productEditLabel" aria-hidden="true">
 <div class="modal-dialog modal-lg modal-dialog-centered">
 <div class="modal-content">
 <div class="modal-header py-2">
 <h6 class="modal-title" id="productEditLabel">Editar producto</h6>
 <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
 </div>
 <form id="productEditForm">
 <div class="modal-body">
 <input type="hidden" id="pe-id" name="Id" />
 <div class="row g-2">
 <div class="col-md-6">
 <label class="form-label small">Nombre</label>
 <input class="form-control form-control-sm" id="pe-name" name="Name" required />
 </div>
 <div class="col-md-6">
 <label class="form-label small">Categoría</label>
 <select class="form-select form-select-sm" id="pe-category" name="CategoryId"></select>
 </div>
 <div class="col-md-6" id="pe-winery-field">
 <label class="form-label small">Bodega</label>
 <input class="form-control form-control-sm" id="pe-winery" name="Winery" />
 </div>
 <div class="col-md-6" id="pe-manufacturer-field" style="display:none;">
 <label class="form-label small">Fabricante</label>
 <input class="form-control form-control-sm" id="pe-manufacturer" name="Manufacturer" />
 <span class="form-text">Para productos no vinos</span>
 </div>
 <div class="col-md-6" id="pe-grape-field">
 <label class="form-label small">Tipo de uva</label>
 <select class="form-select form-select-sm" id="pe-grape" name="GrapeTypeId"></select>
 </div>
 <div class="col-md-3">
 <label class="form-label small">Precio</label>
 <input class="form-control form-control-sm" id="pe-price" name="Price" type="text" inputmode="decimal" />
 </div>
 <div class="col-md-3">
 <label class="form-label small">% Alcohol</label>
 <input class="form-control form-control-sm" id="pe-alcohol" name="AlcoholPercent" type="text" inputmode="decimal" />
 </div>
 <div class="col-md-6">
 <label class="form-label small">Tamaño</label>
 <input class="form-control form-control-sm" id="pe-size" name="Size" />
 </div>
 <div class="col-md-6">
 <label class="form-label small">Origen</label>
 <input class="form-control form-control-sm" id="pe-origin" name="Origin" />
 </div>
 <div class="col-12">
 <label class="form-label small">URL/Imagen</label>
 <input class="form-control form-control-sm" id="pe-image" name="ImageUrl" />
 </div>
 <div class="col-12">
 <label class="form-label small">Descripción</label>
 <textarea class="form-control form-control-sm" id="pe-description" name="Description" rows="3"></textarea>
 </div>
 </div>
 </div>
 <div class="modal-footer py-2">
 <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancelar</button>
 <button type="submit" id="pe-save" class="btn btn-sm btn-primary">Guardar</button>
 </div>
 </form>
 </div>
 </div>
</div>

<script src="~/js/product-inline-edit.js" asp-append-version="true"></script>
